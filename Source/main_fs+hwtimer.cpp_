void printSizeOf() {
    lnprintf("%-10s %d \n", "bool", sizeof(bool));
    lnprintf("%-10s %d \n", "int8_t", sizeof(int8_t));
    lnprintf("%-10s %d \n", "int16_t", sizeof(int16_t));
    lnprintf("%-10s %d \n", "int32_t", sizeof(int32_t));
    lnprintf("%-10s %d \n", "long", sizeof(long));
    lnprintf("%-10s %d \n", "float", sizeof(float));
    lnprintf("%-10s %d \n", "int64_t", sizeof(int64_t));
    lnprintf("%-10s %d \n", "long long", sizeof(long long));
    lnprintf("%-10s %d \n", "double", sizeof(double_t));
}




